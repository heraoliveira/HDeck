{
  "name": "hdeck",
  "productName": "HDeck",
  "version": "2026.11.26",
  "description": "Navegador de várias contas para jogos idle de navegador",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Hera Oliveira",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "pnpm build && electron-builder --config build/electron-builder.yml --win",
    "test": "vitest run --project unidade --project integracao --project componentes",
    "cobertura": "vitest run --project unidade --project integracao --project componentes --coverage",
    "e2e": "pnpm build && playwright test --config tests/playwright.config.ts --project e2e",
    "seguranca": "pnpm build && playwright test --config tests/playwright.config.ts --project seguranca",
    "provas": "pnpm build && playwright test --config tests/playwright.config.ts --project provas",
    "regras": "node tools/regras/conferir.ts",
    "bancada": "pnpm build && node tools/bancada/bancada.ts",
    "jogo-falso": "node tests/fixtures/servidor.ts",
    "lint": "biome check .",
    "formatar": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "knip": "knip",
    "verificar": "pnpm lint && pnpm typecheck && pnpm regras && pnpm cobertura && pnpm seguranca && pnpm e2e"
  },
  "dependencies": {
    "electron-log": "5.4.4",
    "electron-updater": "6.8.11",
    "svelte": "5.59.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.65.1",
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "24.19.4",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.1.2",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "fast-check": "4.11.0",
    "happy-dom": "21.0.4",
    "knip": "6.48.0",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.4.0",
    "vitest": "5.1.2",
    "ws": "8.23.0"
  }
}
