<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Motor das páginas do HDeck (ADR 0014): processo .NET que hospeda as contas em WebView2 (Edge)
    dentro das janelas do Electron. Conversa com o processo principal por JSON em linhas (stdin/stdout).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>hdeck-motor</AssemblyName>
    <RootNamespace>HDeck.Motor</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WebView2LoaderPreference>Static</WebView2LoaderPreference>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <!-- O mesmo ícone do HDeck (janelas de pop-up e o próprio processo, no Gerenciador de Tarefas). -->
    <ApplicationIcon>../build/icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
  </ItemGroup>

</Project>
