{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/out",
      "!**/dist",
      "!**/coverage",
      "!**/test-results",
      "!estrutura",
      "!docs/rastreio.md",
      "!tests/fixtures/**/*.html",
      "!**/*.md",
      "!tools/bancada/resultados",
      "!motor-paginas/bin",
      "!motor-paginas/obj",
      "!motor-paginas/publicado",
      "!tools/prova-webview2/bin",
      "!tools/prova-webview2/obj"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "rules": {
      "style": {
        "noNonNullAssertion": "off"
      },
      "preset": "recommended",
      "complexity": {
        "useOptionalChain": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/main/nucleo/**", "src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "electron": "O núcleo e o shared não podem importar electron (regra 13).",
                  "node:fs": "O núcleo não toca no disco: use uma porta.",
                  "node:net": "O núcleo não toca na rede: use uma porta."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.svelte"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          },
          "style": {
            "useConst": "off"
          }
        }
      }
    },
    {
      "includes": ["tests/provas/**", "tests/e2e/**", "tests/seguranca/**", "tools/bancada/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
