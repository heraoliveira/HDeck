{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 9am on monday"],
  "packageRules": [
    {
      "groupName": "electron",
      "matchPackageNames": ["electron", "electron-builder", "electron-updater", "@electron/fuses"]
    },
    { "matchUpdateTypes": ["patch"], "matchPackageNames": ["electron"], "schedule": ["at any time"] }
  ]
}
